# Variáveis de ambiente para o projeto ETL Leilões
# Nota: Este projeto atualmente usa config/settings.py para configuração
# Este arquivo é mantido para futuras expansões ou personalizações

# Configurações do Dashboard
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=True

# Configurações do Banco de Dados
DB_PATH=data/etl_leiloes.db
DB_TABLE_NAME=parque_leiloes_items

# Configurações do Spider
SPIDER_START_URL=https://www.parquedosleiloes.com.br
SPIDER_CATEGORY=VEÍCULOS
SPIDER_STATUS=Lances online agora

# Configurações de Logging
LOG_LEVEL=INFO
